import turtle as trtl
wn = trtl.Screen()
import random
from functools import partial

#custom turtles
trtl.addshape("P", ((0,3), (.5,2), (1,3), (2,3), (2,-3), (-2,-3), (-2,3)))
trtl.addshape("R", ((0,-2), (-3,-2), (-4,0), (-2,1), (-1,1), (1,2), (2,1), (3,1), (4,0), (3.5,-2)))
trtl.addshape("S", ((0,0), (-2.5,-4), (-4,-3), (-1,1), (-3,2), (-3.5,3), (-4,5), (-3,7), (-2,6), (-1,5), (1,5), (2,6), (3,7), (4,5), (3.5,3), (3,2), (1,1), (4,-3), (2.5,-4), (0,0)))

#varibles
options = ("rock", "paper", "scissors")
player = ""
comp = random.choice(options)
playing = True



rock1 = trtl.Turtle(shape="R")
rock1.name = "rock"
paper1 = trtl.Turtle(shape="P")
paper1.name = "paper"
scissors1 = trtl.Turtle(shape="S")
scissors1.name = "scissors"

start_button = trtl.Turtle()
start_button.shape("square")
start_button.write("Click to Start", align="center", font=("Arial", 16, "bold"))
start_button.color("Black")
start_button.shapesize(2)
start_button.penup()
start_button.goto(0,-35)

rock1.hideturtle()
paper1.hideturtle()
scissors1.hideturtle()


#game functions

def dummy(x,y):
    print()
    




def game_start(x,y):
    start_button.hideturtle()
    start_button.clear()
    rock1.penup()
    rock1.showturtle()
    rock1.shapesize(10)
    rock1.goto(-100,0)
    rock1.left(90)
    paper1.penup()
    paper1.showturtle()
    paper1.shapesize(10)
    paper1.goto(0,0)
    paper1.left(90)
    scissors1.penup()
    scissors1.showturtle()
    scissors1.shapesize(6)
    scissors1.goto(100,0)
    scissors1.left(90)
    rock1.onclick(partial(turtle_clicked, rock1))
    paper1.onclick(partial(turtle_clicked, paper1))
    scissors1.onclick(partial(turtle_clicked, scissors1))

def turtle_clicked(turtle_obj,x,y):
    global player
    player = turtle_obj.name
    turtle_obj.color("red")
    rock1.onclick(dummy)
    paper1.onclick(dummy)
    scissors1.onclick(dummy)
    print(f"Player: {player}")
    print(f"Computer: {comp}")
    if player == comp:
        print("Its a tie!")
    elif player == "rock1" and comp == "scissors1":
        print("You win!")
    elif player == "paper1" and comp == "rock1":
        print("You win!")
    elif player == "scissors1" and comp == "paper1":
        print("You win!")
    else:
        print("You lose")


    

#def game_end(x,y):










start_button.onclick(game_start)

wn.mainloop()